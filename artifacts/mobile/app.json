{
  "expo": {
    "name": "BhaashAI",
    "slug": "bhaashai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bhaashai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bhaashai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BhaashAI needs microphone access to translate your speech in real time.",
        "NSSpeechRecognitionUsageDescription": "BhaashAI uses speech recognition to transcribe your voice."
      }
    },
    "android": {
      "package": "com.bhaashai.app",
      "permissions": ["RECORD_AUDIO", "INTERNET", "MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "BhaashAI needs microphone access to translate your speech."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
