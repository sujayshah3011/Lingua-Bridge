# ElevenLabs API key for TTS integration (server-side only)
# Get yours at https://elevenlabs.io/app/settings/api-keys
# WARNING: Keep this secret. Never commit to git.
ELEVENLABS_API_KEY=

# API server URL for the mobile app
# Set to your deployed API server URL (e.g. https://api.yourdomain.com)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Firebase config (from Firebase Console)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sarvam AI API key
SARVAM_API_KEY=
